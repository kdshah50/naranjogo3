# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here
# Server only — never expose to the browser
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Auth: OTP session JWT (≥32 random chars in production; keep stable across deploys)
JWT_SECRET=

# Twilio WhatsApp (required in production for OTP). Local dev may omit if send-otp allows dev flow.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# FastAPI backend (optional)
FASTAPI_INTERNAL_URL=https://your-fastapi.example.com
INTERNAL_API_SECRET=

# Stripe
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx
# IVA shown on marketplace cart (non-service). Default 16 (Mexico).
MARKETPLACE_VAT_PERCENT=16
# Cart: set true when Stripe Connect is ready (seller payouts). If unset/false, cart charges the platform account only.
MARKETPLACE_CONNECT_REQUIRED=

# App
# Canonical site URL (apex), no trailing slash — e.g. https://naranjogo.com.mx
# Set for Production only in Vercel. Preview deploys use VERCEL_URL automatically (WhatsApp links, etc.).
NEXT_PUBLIC_APP_URL=https://naranjogo.com.mx

# Search: NL parse + dense vectors (required for hybrid semantic search)
OPENAI_API_KEY=
# SEARCH_PARSE_MODEL=gpt-4o-mini
# USD→MXN when user says dollars without pesos (default 17.5)
# SEARCH_MXN_PER_USD=17.5

# Optional: Sentry error monitoring (set in Vercel Production; leave empty to disable)
NEXT_PUBLIC_SENTRY_DSN=

# Admin UI/API (server only — do not use NEXT_PUBLIC_* for the PIN). Use a long random PIN in production.
ADMIN_PIN=

# Dev/CI only: skip production secret assertions during next build. NEVER set in Vercel Production.
# SKIP_PRODUCTION_ENV_GUARD=1

# Content-Security-Policy: enforce (default) | report | off — production only reads CSP_MODE
# CSP_MODE=enforce

# Optional: Upstash Redis — shared OTP IP rate limits across serverless instances (https://upstash.com)
# Also used for per-seller listing creation limits (POST /api/listings + provider-signup) when set.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Vercel Cron: Bearer for GET /api/cron/reconcile-payments. vercel.json runs once daily
# (Hobby); use a per-minute/hourly schedule only on Pro+ or deploys can fail.
CRON_SECRET=

# Optional: booking reminder emails (Resend). WhatsApp uses Twilio above.
RESEND_API_KEY=
# e.g. Naranjogo <recordatorios@tudominio.com> (verify domain in Resend)
REMINDER_EMAIL_FROM=

# Retention (optional): appended to rebook WhatsApp when cron fires. Weekend = Fri 17:00–Sun America/Mexico_City.
# RETENTION_WEEKEND_PROMO_ES=10% en servicios selectos este fin de semana — pregunta en el chat.
# RETENTION_LOCAL_PROMO_ES=Promo vecinos SMA: -15% en limpieza al reservar por la app.
# Home amber strip (server-only). Weekend banner wins on Fri eve–Sun when both are set.
# RETENTION_HOME_BANNER_ES=Reserva de nuevo y mantén tu descuento por lealtad.
# RETENTION_HOME_WEEKEND_BANNER_ES=Fin de semana: encuentra ofertas en servicios locales.
# RETENTION_HOME_BANNER_EN=Book again and keep your loyalty discount.
# RETENTION_HOME_WEEKEND_BANNER_EN=Weekend picks: local service deals on Naranjogo.
